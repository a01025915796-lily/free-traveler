# Free Traveler 환경변수 예시. 실제 값은 .env.local에 두고 Git에 올리지 않는다.
# Service Role Key는 쓰지 않는다. 클라이언트에 노출되는 변수는 아래 NEXT_PUBLIC_* 3개뿐이다.

# canonical·Open Graph 절대 URL (예: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Publishable Key (RLS 적용 공개 키)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 로컬·테스트 전용: 이메일 인증을 마친 Smoke Test 계정 (TEST-RLS-BASIC, E2E-MATE-AUTH)
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
